  "patterns": [
    {
      "match": "^Terseleksi (\\d+) entitas\\.$",
      "replace": "Selected $1 entities."
    },
    {
      "match": "^Sukses mengganti & menyesuaikan ukuran (\\d+) objek\\.$",
      "replace": "Successfully replaced & matched dimensions of $1 object(s)."
    },
    {
      "match": "^Sukses mengganti (\\d+) objek \\(ukuran ikut item baru\\)\\.$",
      "replace": "Successfully replaced $1 object(s) (size follows the new item)."
    },
    {
      "match": "^Skala berhasil di-reset untuk (\\d+) objek\\.$",
      "replace": "Scale successfully reset for $1 object(s)."
    },
    {
      "match": "^Sukses menyembunyikan tag di (\\d+) scene\\.$",
      "replace": "Successfully hid tags in $1 scene(s)."
    },
    {
      "match": "^Sukses menampilkan tag di (\\d+) scene\\.$",
      "replace": "Successfully showed tags in $1 scene(s)."
    },
    {
      "match": "^Sukses menyembunyikan (\\d+) objek di (\\d+) scene\\.$",
      "replace": "Successfully hid $1 object(s) in $2 scene(s)."
    },
    {
      "match": "^Sukses menampilkan (\\d+) objek di (\\d+) scene\\.$",
      "replace": "Successfully showed $1 object(s) in $2 scene(s)."
    },
    {
      "match": "^Terseleksi (\\d+) (Edge|Face|Group|Component) pada tag '([^']*)'\\.$",
      "replace": "Selected $1 $2 on tag '$3'."
    },
    {
      "match": "^Tidak ada (Edge|Face|Group|Component) yang ditemukan pada tag '([^']*)'\\.$",
      "replace": "No $1 found on tag '$2'."
    },
    {
      "match": "^Sukses mengisolasi objek di scene:\\s*(.*)$",
      "replace": "Successfully isolated objects in scene: $1"
    },
    {
      "match": "^Sukses menampilkan semua objek di:\\s*(.*)$",
      "replace": "Successfully showed all objects in: $1"
    },
    {
      "match": "^Gagal End Isolate:\\s*(.*)$",
      "replace": "Failed End Isolate: $1"
    },
    {
      "match": "^Gagal scan:\\s*(.*)$",
      "replace": "Scan failed: $1"
    },
    {
      "match": "^Gagal memasang:\\s*(.*)$",
      "replace": "Failed to install: $1"
    },
    {
      "match": "^Gagal:\\s*(.*)$",
      "replace": "Failed: $1"
    },
    {
      "match": "^Kesalahan Sistem:\\s*(.*)$",
      "replace": "System Error: $1"
    },
    {
      "match": "^Error:\\s*(.*)$",
      "replace": "Error: $1"
    }
  ]
}
